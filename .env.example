# Copy to .env for local runs. On Hugging Face set these under
# Settings -> Variables and secrets; on Render under Environment.

# Shared secret for the X-API-Key header on every /v1/* request.
# LEAVING THIS BLANK DISABLES THE KEY CHECK ENTIRELY -- the service logs a
# warning at startup and then serves anyone. Always set it in production.
GREENGUARD_API_KEY=

# Where model.onnx, labels.json and config.json live. Default: model/
MODEL_DIR=model

# ONNX Runtime intra-op threads. Dockerfile defaults to 2; use 1 on a
# single-core free instance (Render free tier) to avoid thrashing.
ORT_THREADS=2

# Hugging Face Spaces fix this at 7860. Render injects its own PORT.
PORT=7860
